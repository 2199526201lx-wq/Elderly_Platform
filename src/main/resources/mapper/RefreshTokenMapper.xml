<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.elderly_Platform.core.mapper.RefreshTokenMapper">

    <select id="selectById" resultType="com.example.elderly_Platform.core.entity.RefreshToken">
        SELECT * FROM refresh_token WHERE id = #{id}
    </select>

    <select id="selectByToken" resultType="com.example.elderly_Platform.core.entity.RefreshToken">
        SELECT * FROM refresh_token WHERE token = #{token}
    </select>

    <select id="selectByUserId" resultType="com.example.elderly_Platform.core.entity.RefreshToken">
        SELECT * FROM refresh_token
        WHERE user_id = #{userId}
        ORDER BY create_time DESC
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO refresh_token (user_id, token, expire_time, create_time)
        VALUES (#{userId}, #{token}, #{expireTime}, #{createTime})
    </insert>

    <update id="updateById" parameterType="com.example.elderly_Platform.core.entity.RefreshToken">
        UPDATE refresh_token
        <set>
            <if test="token != null and token != ''">
                token = #{token},
            </if>
            <if test="expireTime != null">
                expire_time = #{expireTime},
            </if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteByToken">
        DELETE FROM refresh_token WHERE token = #{token}
    </delete>

    <delete id="deleteByUserId">
        DELETE FROM refresh_token WHERE user_id = #{userId}
    </delete>

    <delete id="deleteExpired">
        DELETE FROM refresh_token WHERE expire_time &lt; NOW()
    </delete>

</mapper>
